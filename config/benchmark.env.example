# Source checkouts
FASTPLS_SOURCE_ROOT=/absolute/path/to/fastPLS
FASTPLS_EXTRA_ROOT=/absolute/path/to/fastPLS-extra

# Inputs may be outside Git when redistribution is restricted.
FASTPLS_DATA_ROOT=/absolute/path/to/prepared/tasks

# All generated CSV, RDS, logs, tables, figures, and documents go here.
FASTPLS_RESULTS_ROOT=/absolute/path/to/fastPLS_results_local/current_candidate
FASTPLS_MANUSCRIPT_OUTPUT=/absolute/path/to/fastPLS_results_local/current_candidate/manuscript
